        {
          "name": "02 · Sign up and try to become ADMIN",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "description": "**Say:** I sent role ADMIN in the body. Look: the account is a USER. Zod strips unknown fields, so nobody can promote themselves. The password hash never comes back, and the Headers tab shows an HttpOnly cookie.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Judge\",\n  \"email\": \"{{demoEmail}}\",\n  \"password\": \"secret123\",\n  \"role\": \"ADMIN\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('demoEmail', `judge_${Date.now()}@demo.dev`);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();"
