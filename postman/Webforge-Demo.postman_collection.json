            "description": "**Say:** I tried to set status and seatsTaken. Both are ignored: every workshop starts as DRAFT with 0 seats taken.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Demo: Building REST APIs\",\n  \"description\": \"Created live during the demo\",\n  \"trainer\": \"Ravi Kumar\",\n  \"venue\": \"Auditorium\",\n  \"startAt\": \"{{startAt}}\",\n  \"endAt\": \"{{endAt}}\",\n  \"capacity\": 40,\n  \"status\": \"PUBLISHED\",\n  \"seatsTaken\": 99\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const s = new Date(Date.now() + 4*24*3600e3); s.setHours(10,0,0,0);",
                  "pm.collectionVariables.set('startAt', s.toISOString());",
                  "pm.collectionVariables.set('endAt', new Date(s.getTime() + 3*3600e3).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.data) pm.collectionVariables.set('demoWsId', json.data.workshop.id);"
