# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# MongoDB Atlas (must be a replica set - Atlas free tier works; needed for transactions)
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/webforge?retryWrites=true&w=majority

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=1d
COOKIE_NAME=token
BCRYPT_SALT_ROUNDS=10

# Rate limits (per IP, per 15 minutes)
AUTH_RATE_LIMIT_MAX=20
GLOBAL_RATE_LIMIT_MAX=300

# Business rules
CANCELLATION_CUTOFF_HOURS=2
CHECKIN_WINDOW_MINUTES=60
DEFAULT_NO_SHOW_GRACE_MINUTES=15

# Email (Nodemailer - use an Ethereal test account for the demo)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Webforge Workshops <no-reply@webforge.dev>"

# Jobs
ENABLE_CRON=true
